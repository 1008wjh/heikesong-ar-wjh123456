# MemoryLens 后端：一个容器，自带模型与人脉库，无外网依赖（LLM 是可选开关）
#
#   docker build -f deploy/Dockerfile.backend -t memorylens .
#   docker run -d -p 8765:8765 -v memorylens-data:/data --name memorylens memorylens
#
# 构建上下文是仓库根目录（要 src/ web/ models/）。
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    AR_PORT=8765 \
    AR_DATA_DIR=/data \
    AR_MEETING_DIR=/data/meetings

WORKDIR /app

# 只装运行时真正需要的四个轮子；opencv 用 headless 版（容器里没有 GUI）
RUN pip install --no-cache-dir \
        "numpy>=2.0" \
        "opencv-python-headless>=4.10" \
        "onnxruntime>=1.19" \
        "sherpa-onnx>=1.10"

COPY src/ /app/src/
COPY web/ /app/web/
COPY models/ /app/models/

RUN mkdir -p /data && useradd -m -u 10001 ml && chown -R ml /data /app
USER ml

VOLUME ["/data"]
EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8765/api/health', timeout=3).status==200 else 1)"

CMD ["python", "src/server.py"]
