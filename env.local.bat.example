@echo off
REM Local secrets -- this file is gitignored, keep it on your machine only.
REM Copy to env.local.bat and fill in what you actually use.

REM Text model (析出). DeepSeek is OpenAI-compatible.
set "DEEPSEEK_API_KEY=sk-your-key-here"
set "AR_LLM_PRESET=deepseek"

